# 小狼杀 AI 代理配置模板
#
# 用法：复制本文件为 .env 并填入你自己的凭证。
#   cp .env.example .env
#
# 安全：.env 已加入 .gitignore，绝不提交。这些变量只在本地 Vite dev-server
# 进程内被读取（src/ai-proxy），API key 永不下发到浏览器、永不进 git。
# 不要使用 / 不要碰 Codex 的 C:/vibecoding/auth.json。

# OpenAI 兼容端点的 base url（需包含到 /v1，结尾不带斜杠）。
# 参考：https://fuck-clau.de/v1
AI_BASE_URL=

# 你的 API Key。
AI_API_KEY=

# 模型名。
AI_MODEL=gpt-5.5

# 线格式：chat = Chat Completions（默认，最通用）；responses = OpenAI Responses API。
# 若你的端点只支持 responses，改成 responses。
AI_WIRE_API=chat

# 单次 LLM 调用超时（毫秒），可选，默认 30000。
# AI_TIMEOUT_MS=30000
